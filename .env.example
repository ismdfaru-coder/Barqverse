# use.ai Scraper Configuration

# Server
PORT=5000
HOST=localhost
NODE_ENV=development

# Frontend
REACT_APP_API_URL=http://localhost:5000

# use.ai Credentials
USE_AI_EMAIL=your-email@gmail.com

# Scraper Settings
HEADLESS=true
SCRAPER_TIMEOUT=30000
SCRAPER_RETRIES=3

# CORS
FRONTEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10
