{
  "name": "use-ai-scraper",
  "version": "1.0.0",
  "description": "Scrape use.ai responses and integrate with React chat app",
  "main": "backend-api.ts",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only backend-api.ts",
    "build": "tsc",
    "start": "node dist/backend-api.js",
    "scraper:test": "ts-node use-ai-scraper.ts",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "web-scraper",
    "use-ai",
    "chatbot",
    "automation"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "express-rate-limit": "^7.1.5",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "playwright": "^1.62.0",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2"
  }
}
